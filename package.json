{
  "name": "fuse-kit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "test": "vite --mode test",
    "prod": "vite --mode prod",
    "build": "node scripts/SyncPdfjsAssets.mjs && vue-tsc -b && vite build --mode prod",
    "build-dev": "node scripts/SyncPdfjsAssets.mjs && vue-tsc -b && vite build --mode dev",
    "build-test": "node scripts/SyncPdfjsAssets.mjs && vue-tsc -b && vite build --mode test",
    "build-prod": "node scripts/SyncPdfjsAssets.mjs && vue-tsc -b && vite build --mode prod",
    "preview": "vite preview",
    "postinstall": "node scripts/SyncPdfjsAssets.mjs",
    "sync-pdfjs": "node scripts/SyncPdfjsAssets.mjs",
    "server:dev": "npm --prefix server run dev",
    "server:deploy": "npm --prefix server run deploy",
    "server:deploy:full": "npm --prefix server run deploy:full",
    "server:install": "npm --prefix server install --legacy-peer-deps"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "gifuct-js": "^2.1.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0",
    "vuex-persistedstate": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "terser": "^5.49.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^2.1.10"
  }
}
